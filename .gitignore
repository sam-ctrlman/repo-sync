.claude/

# >>> meminit (AI-memory dirs — own git repos, never tracked here)
.gemini/
.codex/
.antigravity/
# <<< meminit

# /memlayout: credentials — never commit
.env*.local
*.pem
*.key
*.p12
*.pfx
secrets/
*.credentials
*service-account*.json
id_rsa*
id_ed25519*

# workspace: Claude memory + notes stay local (never tracked)
/docs
/docs/

# python
__pycache__/

# git-identity: base (OS files, logs, backups)
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*:Zone.Identifier
*.log
*.orig
*.sw?

# git-identity: editors (Zed, VS Code, Sublime; TextMate leaves no project folder)
.zed/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace

# git-identity: python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
/dist/
/build/
